# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=generate-with--python-secrets-token-hex-32--
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Azure Blob Storage ────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"

# ── AI / OpenAI ───────────────────────────────────────────────────────────────
GITHUB_TOKEN=your-github-or-openai-token
GITHUB_MODEL_NAME=gpt-4o-mini

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Ambil dari Supabase Dashboard > Settings > API > JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Supabase URL (untuk verifikasi token Google OAuth via JWKS) ───────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# ── CORS (Production only — kosongkan untuk lokal) ────────────────────────────
FRONTEND_URL=http://foodoverfuss.southeastasia.cloudapp.azure.com
